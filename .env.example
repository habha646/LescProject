# Copie ce fichier en ".env" (jamais commité) et adapte.
SENTINELLE_SECRET_KEY=change-moi
# fake = appareils simulés (par défaut) | real = vrai scan (module de David)
SENTINELLE_NETWORK_MODE=fake
# Sous-réseaux AUTORISÉS pour un vrai scan, séparés par des virgules. Vide = aucun scan réel possible.
# Exemple: 192.168.1.0/24  (uniquement un réseau qui t'appartient ou dont tu as l'accord écrit)
SENTINELLE_ALLOWED_SUBNETS=
# template = texte prédéfini (par défaut) | ollama = modèle local (module de Svetoslav)
SENTINELLE_AI_MODE=template
